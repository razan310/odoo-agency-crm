# Copy to .env (`make up` does it for you on first run) and change the
# passwords for anything beyond local development. .env is gitignored.

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo

# --- Odoo ---------------------------------------------------------------
# Database used by this project.
ODOO_DB=agency_crm
# Host port for the Odoo web UI: http://localhost:8069
ODOO_PORT=8069
# Master password (admin_passwd): protects the database manager
# at /web/database/manager. Not used to log in.
ODOO_MASTER_PASSWORD=change-me-master
# Login password of the "admin" user, applied when the database is created.
ODOO_ADMIN_PASSWORD=admin
